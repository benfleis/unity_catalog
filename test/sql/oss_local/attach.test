# name: test/sql/oss_local/attach.test
# description: attach/detach/USE semantics for the unity_catalog extension against the OSS UC ducklabs image. Paired attach.py declares the server (uc_server) and seeds duck.managed.id_name.
# group: [oss_local]

require parquet

require unity_catalog

require delta

require httpfs

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

# -----------------------------------------------------------------------------
# Attach without a default schema
#

statement ok
ATTACH 'duck' (TYPE unity_catalog);

# USE <catalog> alone fails: OSS UC exposes no default schema to resolve to.
statement error
USE duck;
----
Catalog Error: SET schema: No catalog + schema named "duck" found.

# ... but a fully-qualified catalog.schema works.
statement ok
USE duck.managed;

statement ok
USE memory;

statement ok
DETACH duck;

# -----------------------------------------------------------------------------
# Attach with DEFAULT_SCHEMA
#

statement ok
ATTACH 'duck' (TYPE unity_catalog, DEFAULT_SCHEMA 'managed');

statement ok
USE duck;

# Write a row through the catalog-managed path, then read it back (id_name is
# seeded empty by attach.py).
statement ok
INSERT INTO id_name VALUES (2, 'two');

query II
SELECT id, name FROM id_name LIMIT 1;
----
2	two
