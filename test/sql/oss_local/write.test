# name: test/sql/oss_local/write.test
# description: test uc_catalog writes against the OSS UC "duck" image (catalog-managed table)
# group: [oss_local]

# Run write.py first to seed an empty CMT table duck.managed.id_name in the
# running duck image (and `write.py teardown` to drop it after). See that file.

# Require statement will ensure this test is run with this extension loaded
require parquet

require unity_catalog

require delta

require httpfs

require-env UC_TEST_SERVER_RUNNING

statement ok
CREATE SECRET (
    TYPE UC,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

# Catalog Secret
statement ok
ATTACH 'duck' AS my_catalog (TYPE UC_CATALOG, DEFAULT_SCHEMA 'managed');

# We can switch to a specific schema
statement ok
USE my_catalog.managed;

# write.py created id_name empty; reading it is fine.
statement ok
FROM id_name;

statement ok
INSERT INTO id_name VALUES (1, 'blabla');

# Second insert verifies PlanInsert credential ordering (RefreshCredentials before
# InternalAttach). id_name is catalog-managed (MANAGED in this image always is).
statement ok
INSERT INTO id_name VALUES (2, 'blabla2');

query II
SELECT id, name FROM id_name WHERE id IN (1, 2) ORDER BY id;
----
1	blabla
2	blabla2
