# name: test/sql/oss_local/catalog_managed.test
# description: catalog-managed read+write on duck.managed.id_name against the OSS UC ducklabs image (delta.yaml v1 LoadTable/UpdateTable). The paired catalog_managed.py driver declares the running server (uc_server fixture) and seeds the table -- no require-env guard needed.
# group: [oss_local]

require parquet

require unity_catalog

require delta

require httpfs

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH 'duck' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'managed');

statement ok
CALL enable_logging(level='DEBUG');

# -----------------------------------------------------------------------------
# CMT read path
#
# id_name carries delta.feature.catalogManaged (MANAGED == catalog-managed in this
# image), so InternalAttach calls LoadTable (delta.yaml v1 GET .../tables/{table}).
#

statement ok
FROM duck.managed.id_name;

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE message LIKE 'uc-api.LoadTable duck.managed.id_name%';
----
true

# -----------------------------------------------------------------------------
# CMT write path
#
# INSERT exercises UpdateTable (delta.yaml v1 add-commit). The second INSERT also
# verifies PlanInsert credential ordering (RefreshCredentials before InternalAttach).
#

statement ok
INSERT INTO duck.managed.id_name VALUES (1, 'blabla');

statement ok
INSERT INTO duck.managed.id_name VALUES (2, 'blabla2');

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE message LIKE 'uc-api.UpdateTable duck.managed.id_name%';
----
true

# -----------------------------------------------------------------------------
# Round-trip
#

query II
SELECT id, name FROM duck.managed.id_name WHERE id IN (1, 2) ORDER BY id;
----
1	blabla
2	blabla2
