# name: test/sql/oss_local/table-cmt/catalog_managed.test
# description: catalog-managed PROTOCOL contrast -- duck.cmt tables ARE catalog-managed, so reading calls LoadTable and writing calls UpdateTable (delta.yaml v1). The shared data round-trip lives in oss_local/rw.test; this asserts ONLY the protocol calls (the cmt half of the contrast with table-plain/catalog_managed). Paired catalog_managed.py seeds duck.cmt.id_name.
# group: [oss_local]

require parquet

require unity_catalog

require delta

require httpfs

require-env UC_TEST_CATALOG

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH '${UC_TEST_CATALOG}' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'cmt');

statement ok
CALL enable_logging(level='DEBUG');

# -----------------------------------------------------------------------------
# CMT read path: id_name carries delta.feature.catalogManaged, so InternalAttach
# calls LoadTable (delta.yaml v1 GET .../tables/{table}).
#

statement ok
FROM duck.cmt.id_name;

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE message LIKE 'uc-api.LoadTable duck.cmt.id_name%';
----
true

# -----------------------------------------------------------------------------
# CMT write path: INSERT exercises UpdateTable (delta.yaml v1 add-commit).
#

statement ok
INSERT INTO duck.cmt.id_name VALUES (1, 'blabla');

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE message LIKE 'uc-api.UpdateTable duck.cmt.id_name%';
----
true
