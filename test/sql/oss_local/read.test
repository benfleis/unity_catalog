# name: test/sql/oss_local/read.test
# description: catalog-managed multi-row read + catalog metadata (duckdb_tables) against the OSS UC ducklabs image. Paired read.py declares the server (uc_server) and seeds duck.managed.{scores,people}.
# group: [oss_local]

require parquet

require unity_catalog

require delta

require httpfs

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH 'duck' (TYPE unity_catalog, DEFAULT_SCHEMA 'managed');

statement ok
USE duck.managed;

# -----------------------------------------------------------------------------
# Write a known dataset, then read it back (tables seeded empty by read.py)
#

statement ok
INSERT INTO scores VALUES (1, 'alice', 90), (2, 'bob', 75), (3, 'carol', 88);

statement ok
INSERT INTO people VALUES ('alice', 30, 'NL'), ('bob', 41, 'BE');

query III
SELECT id, name, score FROM scores ORDER BY id;
----
1	alice	90
2	bob	75
3	carol	88

query III
SELECT name, age, country FROM people ORDER BY name;
----
alice	30	NL
bob	41	BE

# -----------------------------------------------------------------------------
# Catalog metadata lists the seeded catalog-managed tables
#

query III
SELECT database_name, schema_name, table_name FROM duckdb_tables() WHERE database_name='duck' ORDER BY table_name;
----
duck	managed	people
duck	managed	scores
