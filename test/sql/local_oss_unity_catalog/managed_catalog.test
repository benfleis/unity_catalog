# name: test/sql/local_oss_unity_catalog/managed_catalog.test
# description: read and write on a catalog-managed table via delta.yaml v1 (LoadTable / UpdateTable)
# group: [local_oss_unity_catalog]

require parquet

require unity_catalog

require delta

require httpfs

require-env UC_TEST_SERVER_RUNNING

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN 'not-used',
    ENDPOINT 'http://127.0.0.1:8080',
    AWS_REGION 'us-east-2'
);

statement ok
ATTACH 'duck' AS duck (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'cmt');

statement ok
CALL enable_logging(level='DEBUG');

# -----------------------------------------------------------------------------
# Non-CMT table — marksheet is MANAGED in OSS UC but has no catalogManaged Delta
# writer feature, so IsCatalogManaged() returns false and LoadTable is NOT called
#

statement ok
ATTACH 'unity' AS uc (TYPE UNITY_CATALOG, DEFAULT_SCHEMA 'default');

statement ok
FROM uc.default.marksheet;

query I
SELECT count(*) FROM duckdb_logs()
WHERE message LIKE 'uc-api.LoadTable unity.default.marksheet%';
----
0

# -----------------------------------------------------------------------------
# CMT read path — cmt_test has delta.feature.catalogManaged, so InternalAttach
#                 calls LoadTable (delta.yaml v1 GET .../tables/{table})
#

statement ok
FROM duck.cmt.cmt_test;

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE message LIKE 'uc-api.LoadTable duck.cmt.cmt_test%';
----
true

# -----------------------------------------------------------------------------
# CMT write path — INSERT exercises UpdateTable (delta.yaml v1 add-commit)
#

statement ok
INSERT INTO duck.cmt.cmt_test VALUES (1, 'managed_cat_test');

query I
SELECT count(*) > 0 FROM duckdb_logs()
WHERE message LIKE 'uc-api.UpdateTable duck.cmt.cmt_test%';
----
true
