# name: test/sql/databricks/scan_plan.test
# description: scan plan API (IRC) against Databricks Unity Catalog
# group: [databricks]

require parquet

require unity_catalog

require delta

require httpfs

require-env DATABRICKS_TOKEN

require-env DATABRICKS_ENDPOINT

require-env DATABRICKS_REGION

require-env DATABRICKS_SCAN_PLAN_ENDPOINT

statement ok
CREATE SECRET (
    TYPE UNITY_CATALOG,
    TOKEN '${DATABRICKS_TOKEN}',
    ENDPOINT '${DATABRICKS_ENDPOINT}',
    AWS_REGION '${DATABRICKS_REGION}'
);

# -----------------------------------------------------------------------------
# Baseline: Delta path (no scan_plan_endpoint) — establishes expected_res
#

statement ok
ATTACH 'duckdb_testing' (TYPE UNITY_CATALOG, READ_ONLY, DEFAULT_SCHEMA 'main');

query I nosort expected_res
FROM duckdb_testing.main.simple_table;

statement ok
DETACH duckdb_testing

# -----------------------------------------------------------------------------
# Scan plan path — must return identical rows
#

statement ok
ATTACH 'duckdb_testing' (TYPE UNITY_CATALOG, READ_ONLY, DEFAULT_SCHEMA 'main',
    scan_plan_endpoint '${DATABRICKS_SCAN_PLAN_ENDPOINT}');

query I nosort expected_res
FROM duckdb_testing.main.simple_table;

# Filter pushdown: IRC Expression JSON is sent to the server
query I nosort expected_res
SELECT * FROM duckdb_testing.main.simple_table WHERE id > 0;

statement ok
DETACH duckdb_testing
