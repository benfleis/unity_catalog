# name: test/databricks/write_tests/write.test
# description: write path -- attach a provisioned Unity Catalog table (plain/external cell) and round-trip an INSERT.
# group: [write_tests]

# Require statement will ensure this test is run with this extension loaded
require parquet

require unity_catalog

require delta

require httpfs

require-env DATABRICKS_TOKEN

require-env DATABRICKS_ENDPOINT

require-env DATABRICKS_REGION

require-env UC_TEST_CATALOG

require-env UC_TEST_SCHEMA

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
CREATE SECRET (
    TYPE unity_catalog,
    TOKEN '{DATABRICKS_TOKEN}',
    ENDPOINT '{DATABRICKS_ENDPOINT}',
    AWS_REGION '{DATABRICKS_REGION}'
);

# Attach to databricks through the unity catalog API
statement ok
ATTACH '{UC_TEST_CATALOG}' AS databricks_catalog (TYPE unity_catalog, DEFAULT_SCHEMA '{UC_TEST_SCHEMA}');

statement ok
USE databricks_catalog;

query I
SELECT * FROM simple_table ORDER BY id;
----
1
2
3
4
5

statement ok
INSERT INTO simple_table VALUES (10);

query I
SELECT * FROM simple_table ORDER BY id;
----
1
2
3
4
5
10
