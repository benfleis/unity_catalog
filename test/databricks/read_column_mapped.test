# name: test/databricks/read_column_mapped.test
# description: read-only reads of column-mapped / schema-evolved Delta tables via Unity Catalog.
# group: [databricks]

require parquet

require unity_catalog

require delta

require httpfs

require-env DATABRICKS_TOKEN

require-env DATABRICKS_ENDPOINT

require-env DATABRICKS_REGION

require-env UC_TEST_CATALOG

require-env UC_TEST_SCHEMA

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

statement ok
CREATE SECRET (
    TYPE unity_catalog,
    TOKEN '{DATABRICKS_TOKEN}',
    ENDPOINT '{DATABRICKS_ENDPOINT}',
    AWS_REGION '{DATABRICKS_REGION}'
);

statement ok
ATTACH '{UC_TEST_CATALOG}' (TYPE unity_catalog, READ_ONLY, DEFAULT_SCHEMA '{UC_TEST_SCHEMA}');

# -----------------------------------------------------------------------------
# Column-mapped reads
#

query II
from {UC_TEST_CATALOG}.{UC_TEST_SCHEMA}.evolution_simple_name_mode ORDER BY all
----
1	NULL
2	2

query II
from {UC_TEST_CATALOG}.{UC_TEST_SCHEMA}.evolution_column_change ORDER BY a
----
value1	NULL
value3	NULL
value4	5

query II
SELECT a,b from {UC_TEST_CATALOG}.{UC_TEST_SCHEMA}.evolution_column_change ORDER BY a
----
value1	NULL
value3	NULL
value4	5

# -----------------------------------------------------------------------------
# Projections + generated/virtual columns (FIXME: rowid columns can't be delegated yet)
#

mode skip

query IIII
SELECT file_row_number, filename.substring(-8,8), b, a from {UC_TEST_CATALOG}.{UC_TEST_SCHEMA}.evolution_column_change order by a
----
0	.parquet	NULL	value1
0	.parquet	NULL	value3
0	.parquet	5	value4
